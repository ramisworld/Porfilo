// PortHub Prisma schema — see docs/ARCHITECTURE.md §6
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── BetterAuth (Phase 2) ─────────────────────────────
// Field names match BetterAuth's expected schema; do not rename without also
// adjusting the auth config. Session is server-side (DB row + httpOnly cookie).

model User {
  id             String          @id @default(cuid())
  name           String?
  email          String          @unique
  emailVerified  Boolean         @default(false)
  image          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sessions       Session[]
  accounts       Account[]
  portfolios     Portfolio[]
  generationLock GenerationLock?
  featureAccess  FeatureAccess[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String    @db.Text
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
}

// ───────────────────────── Porfilo domain models ────────────────────────────

// A generated portfolio. From Phase 2 onward, ownerId is always set on new rows.
// Pre-Phase-2 rows may still be ownerless until they're claimed or pruned.
model Portfolio {
  id             String         @id @default(cuid())
  ownerId        String?        @unique
  owner          User?          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  githubUsername String
  slug                String         @unique
  // Long crypto-safe slug for preview URLs: https://<publicSubdomainSlug>.porfilo.com
  publicSubdomainSlug String         @unique
  vibe           String
  profileData    Json
  designSpec     Json?
  engineVersion  String?
  template       String         @default("terminalNexus")
  code           String?        @db.Text
  // Cached social preview captured from this portfolio's actual rendered hero.
  ogImage        Bytes?
  ogImageFingerprint String?
  isPublic       Boolean        @default(true)
  views          Int            @default(0)
  // SHA-256 of the one-time claim token handed to the anonymous browser that
  // generated this portfolio. Required to claim it, so knowledge of the public
  // preview URL alone is NOT sufficient to take ownership. Null once claimed or
  // for portfolios created while signed in.
  claimNonce     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  customDomain   CustomDomain?

  @@index([githubUsername])
  // Supports scheduled pruning of expired anonymous claim previews.
  @@index([ownerId, createdAt])
}

// A user-owned hostname (e.g. portfolio.max.com) attached to a Portfolio.
//
// Beta cap: one CustomDomain per Portfolio (and a Portfolio is one-per-user),
// so effectively one custom domain per account. The hostname is verified +
// served by Cloudflare for SaaS — `cfHostnameId` is the id Cloudflare gives
// us when we register the hostname; we use it to poll status + delete later.
model CustomDomain {
  id              String    @id @default(cuid())
  portfolioId     String    @unique
  portfolio       Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  hostname        String    @unique
  // free_subdomain | custom_domain
  type            String    @default("custom_domain")
  // Cloudflare's id for this custom hostname (custom_domain only).
  // Nullable so we can persist the row even if the call fails mid-creation.
  cfHostnameId    String?   @unique
  // Railway Custom Domains API: the id Railway assigns to this domain, plus
  // the per-domain DNS values Railway returns (CNAME target + verify TXT).
  railwayDomainId   String? @unique
  cnameHost         String? // Railway's CNAME host label ("" = apex/@)
  cnameTarget       String? // e.g. w9kc0szy.up.railway.app
  verificationHost  String? // zone-relative TXT name, e.g. _railway-verify
  verificationToken String? // TXT value to prove ownership
  // Internal status: pending_dns | verifying | active | action_needed | error
  status          String    @default("pending")
  dnsVerified     Boolean   @default(false)
  httpVerified    Boolean   @default(false)
  // Raw provider sub-statuses cached for the UI.
  ownershipStatus String?
  sslStatus       String?
  errorReason     String?
  lastCheckedAt   DateTime?
  activatedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model GitHubCache {
  username  String   @id
  raw       Json
  fetchedAt DateTime @default(now())
}

// Shared fixed-window counters for abuse controls. Keeping these in Postgres
// makes limits consistent across Railway replicas and process restarts.
model RateLimitBucket {
  key       String   @id
  hits      Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

// A one-time, account-level entitlement unlocking a paid feature.
//
// "premium" is a single $9 lifetime unlock. It gates custom domains and
// replace-in-place portfolio regeneration. Access is permanent: removing a
// domain later does not revoke it. Fulfilment happens only after a server-side
// validation of the Stripe Checkout Session.
//
// One row per (userId, featureKey) — the @@unique makes duplicate paid records
// impossible and makes webhook fulfilment idempotent. The pending row is created
// when checkout starts; the webhook flips it to "paid".
model FeatureAccess {
  id                      String    @id @default(cuid())
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Stable feature identifier, currently "premium".
  featureKey              String
  // pending | paid | failed
  status                  String    @default("pending")
  // Stripe references. Unique so a session/intent can fulfil at most one row.
  stripeCheckoutSessionId String?   @unique
  stripePaymentIntentId   String?   @unique
  // Amount in the smallest currency unit (cents). $9 = 900. Internal only.
  amount                  Int       @default(900)
  // ISO currency code — internal bookkeeping only, never rendered in the UI.
  currency                String    @default("usd")
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  paidAt                  DateTime?

  @@unique([userId, featureKey])
  @@index([userId])
  @@index([featureKey])
  @@index([status])
}

// Short-lived lock acquired before expensive GitHub/LLM work starts.
// This prevents multi-tab duplicate generation attempts from burning cost before
// the one-portfolio-per-user database constraint can reject the race loser.
model GenerationLock {
  id             String   @id @default(cuid())
  ownerId        String   @unique
  owner          User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  githubUsername String
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@index([expiresAt])
}

// Cross-replica leases for expensive bounded work (LLM generation and
// Chromium hero capture). Expired leases can be reclaimed after a crashed
// process, while the compound primary key gives each work kind fixed slots.
model WorkSlot {
  kind      String
  slot      Int
  token     String?
  expiresAt DateTime?
  updatedAt DateTime @updatedAt

  @@id([kind, slot])
  @@index([kind, expiresAt])
}

// Durable daily LLM accounting. A row is reserved before any paid model call;
// exact usage is recorded after each call and settled even when generation
// later fails. Expired pending reservations retain recorded actual spend.
model LlmSpendReservation {
  id             String   @id @default(cuid())
  day            String
  status         String   @default("pending")
  reservedMicros Int
  actualMicros   Int      @default(0)
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([day, status, expiresAt])
  @@index([expiresAt])
}
